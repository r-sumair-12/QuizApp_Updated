<Page x:Class="Quiz_Updated_App.SubmitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quiz_Updated_App"
      mc:Ignorable="d" 
      d:DesignHeight="380"
      d:DesignWidth="400"
      Title="SubmitPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Content="Congratulations 🎉🌟"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Grid.Column="1"
                   Name="GreetingLabel"/>

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center">
            <Label Content="Score"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White"
                   HorizontalAlignment="Center"/>

            <TextBlock Text="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Name="TotalScore"/>

            <Button Content="Reset"
                    Style="{StaticResource AppBtn}"
                    Height="30"
                    Width="120"
                    Margin="0,10,0,0" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Page>
