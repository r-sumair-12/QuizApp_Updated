<Page x:Class="Quiz_Updated_App.QuizUIPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Quiz_Updated_App"
      mc:Ignorable="d" 
      d:DesignHeight="380" d:DesignWidth="400"
      Title="QuizUIPage">

    <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
            <TextBlock Text="Total Questions"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="WhiteSmoke"
                           />
            <TextBlock Text="0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="WhiteSmoke"
                           Margin="10,0,40,0"
                           Name="NumberOfQuestions"
                           />
        </StackPanel>

        <TextBlock Name="QuizQuestion"
                           Margin="30,0,0,30"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Text="1. This is question statment 1?"
                           TextWrapping="Wrap"
                           Width="320"
                           Foreground="WhiteSmoke"
                           FontSize="14"
                           Grid.Row="1"/>

        <StackPanel Grid.Row="2"
                            Margin="50,10,0,0"
                            >
            <RadioButton Content="Option 1"
                                 GroupName="QuizOptions"
                                 Style="{StaticResource Options}"
                                 Name="Opt1"/>
            <RadioButton Content="Option 2"
                                 GroupName="QuizOptions"
                                 Style="{StaticResource Options}"
                                 Name="Opt2"/>
            <RadioButton Content="Option 3"
                                 GroupName="QuizOptions"
                                 Style="{StaticResource Options}"
                                 Name="Opt3"/>
            <RadioButton Content="Option 4"
                                 GroupName="QuizOptions"
                                 Style="{StaticResource Options}"
                                 Name="Opt4"/>
        </StackPanel>

        <Grid Grid.Row="3"
                      Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                            Height="35"
                            VerticalAlignment="Top"
                            Style="{StaticResource AppBtn}"
                            Content="Next"
                            Name="NextBtn"
                            Click="NextBtn_Click"/>
        </Grid>
    </Grid>
</Page>
